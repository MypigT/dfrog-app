{
  "name": "dfrog-desktop",
  "version": "0.1.0",
  "description": "Dfrog AI 桌面宠物（形象可自由切换）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.dfrog.pet",
    "productName": "AI桌宠",
    "directories": {
      "output": "../release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/dfrog-backend.exe",
        "to": "backend/dfrog-backend.exe"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
